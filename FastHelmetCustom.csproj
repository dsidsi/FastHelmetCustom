<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <AssemblyName>FastHelmetCustom</AssemblyName>
    <Version>1.1.3</Version>
  </PropertyGroup>

  <!--
    需要本机 SPT 服务端的程序集才能编译。
    在仓库根目录复制 Directory.Build.props.example 为 Directory.Build.props，
    并把 GamePath 改成你的 SPT 游戏根目录（与 EscapeFromTarkov.exe 同级）。
  -->
  <ItemGroup>
    <Reference Include="SPTarkov.Common">
      <HintPath>$(GamePath)\SPT\SPTarkov.Common.dll</HintPath>
    </Reference>
    <Reference Include="SPTarkov.DI">
      <HintPath>$(GamePath)\SPT\SPTarkov.DI.dll</HintPath>
    </Reference>
    <Reference Include="SPTarkov.Server.Core">
      <HintPath>$(GamePath)\SPT\SPTarkov.Server.Core.dll</HintPath>
    </Reference>
    <Reference Include="SemanticVersioning">
      <HintPath>$(GamePath)\SPT\SemanticVersioning.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
